# =====================================================================
# Relexa Exports — Production Environment Configuration
# =====================================================================
# Copy this file to `.env` and fill in your real values:
#   cp .env.example .env
#
# IMPORTANT: `.env` is gitignored. NEVER commit secret keys to Git.
# =====================================================================

# --- SITE DOMAIN CONFIGURATION ---
# The public canonical URL of your deployed site (used in sitemaps, Open Graph, etc.)
VITE_SITE_URL=https://example.com
SITE_URL=https://example.com

# Canonical domain host for server-level 301 redirects (e.g. example.com)
CANONICAL_HOST=example.com

# Set to true to enforce automatic HTTP -> HTTPS 301 redirection on the Node server
FORCE_HTTPS=false

# --- CONTACT FORM / WEB3FORMS CONFIGURATION ---
# Web3Forms access key from https://web3forms.com/
# VITE_ prefix exposes the key to the client-side React bundle (official Web3Forms architecture)
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# --- SERVER CONFIGURATION ---
NODE_ENV=production
PORT=3001
